generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  PROJECT_MANAGER
  COMPLIANCE_OFFICER
  ME_OFFICER
  FINANCE_OFFICER
  SUPPLY_CHAIN_OFFICER
  DEPARTMENT_HEAD
  VIEWER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATING
  ACCEPTED
  CLOSED
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CLOSED
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

enum FinanceEntryType {
  COMMITMENT
  EXPENDITURE
}

enum FinanceRecordStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum FinanceApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  CLOSED
  REOPENED
}

enum RegulationType {
  LAW
  REGULATION
  POLICY
  STANDARD
  GUIDELINE
  LICENCE_REQUIREMENT
}

enum ComplianceRegisterStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ComplianceObligationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  OVERDUE
  WAIVED
}

enum PermitStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
  REVOKED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionOutcome {
  NOT_ASSESSED
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
}

enum NonConformitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NonConformityStatus {
  OPEN
  INVESTIGATING
  ACTION_IN_PROGRESS
  PENDING_VERIFICATION
  CLOSED
  ESCALATED
}

enum CorrectiveActionStatus {
  PLANNED
  IN_PROGRESS
  PENDING_VERIFICATION
  COMPLETED
  OVERDUE
  CANCELLED
}

enum EscalationLevel {
  NONE
  DEPARTMENT_HEAD
  EXECUTIVE
  REGULATOR
}

enum SupplierSector {
  UPSTREAM
  MIDSTREAM
  DOWNSTREAM
  CROSS_SECTOR
}

enum SupplierStatus {
  DRAFT
  PENDING_QUALIFICATION
  QUALIFIED
  SUSPENDED
  BLACKLISTED
  INACTIVE
}

enum QualificationStatus {
  NOT_STARTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum SupplierContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  SUSPENDED
  TERMINATED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  ACCEPTED
  REJECTED
  LATE
}

enum ResultsFrameworkStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ResultLevelType {
  IMPACT
  OUTCOME
  OUTPUT
}

enum KpiIndicatorStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KpiDirection {
  INCREASE
  DECREASE
  MAINTAIN
}

enum KpiDataType {
  NUMBER
  PERCENTAGE
  CURRENCY
  COUNT
  BOOLEAN
}

enum KpiFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  AD_HOC
}

enum KpiPeriodStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
  CLOSED
}

enum KpiMeasurementStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
}

enum KpiSourceType {
  MANUAL
  TELEMETRY
  ANALYTICS
  FINANCE
  COMPLIANCE
  SUPPLY_CHAIN
}

enum KpiAggregation {
  VALUE
  AVERAGE
  SUM
  MINIMUM
  MAXIMUM
  COUNT
}

model User {
  id                           String                      @id @default(uuid()) @db.Uuid
  name                         String
  email                        String                      @unique
  passwordHash                 String
  role                         Role                        @default(VIEWER)
  walletAddress                String?
  isActive                     Boolean                     @default(true)
  tokenVersion                 Int                         @default(0)
  lastLoginAt                  DateTime?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  auditEvents                  AuditLog[]                  @relation("AuditActor")
  managedProjects              Project[]                   @relation("ProjectManager")
  projectAssignments           ProjectAssignment[]
  assignedActivities           ProjectActivity[]           @relation("ActivityAssignee")
  assignedDeliverables         ProjectDeliverable[]        @relation("DeliverableAssignee")
  ownedRisks                   ProjectRisk[]               @relation("RiskOwner")
  createdBudgets               ProjectBudget[]             @relation("BudgetCreator")
  submittedBudgets             ProjectBudget[]             @relation("BudgetSubmitter")
  reviewedBudgets              ProjectBudget[]             @relation("BudgetReviewer")
  budgetApprovals              BudgetApproval[]
  createdFinanceEntries        FinanceEntry[]              @relation("FinanceEntryCreator")
  reviewedFinanceEntries       FinanceEntry[]              @relation("FinanceEntryReviewer")
  financeDocuments             FinanceDocument[]
  createdRegulations           ComplianceRegulation[]      @relation("RegulationCreator")
  responsibleObligations       ComplianceObligation[]      @relation("ObligationOfficer")
  verifiedObligations          ComplianceObligation[]      @relation("ObligationVerifier")
  responsiblePermits           CompliancePermit[]          @relation("PermitOfficer")
  responsibleInspections       ComplianceInspection[]      @relation("InspectionOfficer")
  responsibleNonConformities   NonConformity[]             @relation("NonConformityOfficer")
  responsibleCorrectiveActions CorrectiveAction[]          @relation("CorrectiveActionOfficer")
  verifiedCorrectiveActions    CorrectiveAction[]          @relation("CorrectiveActionVerifier")
  complianceEvidence           ComplianceEvidence[]
  complianceEvents             ComplianceWorkflowEvent[]
  createdSuppliers             Supplier[]                  @relation("SupplierCreator")
  reviewedQualifications       SupplierQualification[]     @relation("QualificationReviewer")
  managedSupplierContracts     SupplierContract[]          @relation("SupplierContractOfficer")
  createdPurchaseRequests      PurchaseRequest[]           @relation("PurchaseRequestCreator")
  reviewedPurchaseRequests     PurchaseRequest[]           @relation("PurchaseRequestReviewer")
  acceptedDeliveries           SupplierDelivery[]          @relation("DeliveryAcceptor")
  supplierPerformanceReviews   SupplierPerformanceReview[] @relation("SupplierReviewAuthor")
  supplierEvidence             SupplierEvidence[]
  supplierWorkflowEvents       SupplierWorkflowEvent[]
  ownedResultsFrameworks       ResultsFramework[]          @relation("ResultsFrameworkOwner")
  ownedKpiIndicators           KpiIndicator[]              @relation("KpiIndicatorOwner")
  createdKpiPeriods            KpiReportingPeriod[]        @relation("KpiPeriodCreator")
  submittedKpiPeriods          KpiReportingPeriod[]        @relation("KpiPeriodSubmitter")
  reviewedKpiPeriods           KpiReportingPeriod[]        @relation("KpiPeriodReviewer")
  createdKpiMeasurements       KpiMeasurement[]            @relation("KpiMeasurementCreator")
  verifiedKpiMeasurements      KpiMeasurement[]            @relation("KpiMeasurementVerifier")
  kpiEvidence                  KpiEvidence[]
  kpiWorkflowEvents            KpiWorkflowEvent[]

  @@index([role])
  @@index([isActive])
}

model Project {
  id                    String                 @id @default(uuid()) @db.Uuid
  title                 String
  code                  String                 @unique
  department            String
  location              String
  managerId             String                 @db.Uuid
  startDate             DateTime
  endDate               DateTime
  status                ProjectStatus          @default(PLANNED)
  progress              Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  manager               User                   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  objectives            ProjectObjective[]
  activities            ProjectActivity[]
  milestones            ProjectMilestone[]
  deliverables          ProjectDeliverable[]
  risks                 ProjectRisk[]
  assignments           ProjectAssignment[]
  budgets               ProjectBudget[]
  complianceObligations ComplianceObligation[]
  compliancePermits     CompliancePermit[]
  complianceInspections ComplianceInspection[]
  nonConformities       NonConformity[]
  supplierContracts     SupplierContract[]
  purchaseRequests      PurchaseRequest[]
  resultsFrameworks     ResultsFramework[]

  @@index([department])
  @@index([managerId])
  @@index([status])
  @@index([startDate, endDate])
}

model ProjectBudget {
  id             String                     @id @default(uuid()) @db.Uuid
  projectId      String                     @db.Uuid
  fiscalYear     Int
  title          String
  currency       String                     @default("USD")
  proposedAmount Decimal                    @db.Decimal(18, 2)
  approvedAmount Decimal                    @default(0) @db.Decimal(18, 2)
  status         BudgetStatus               @default(DRAFT)
  notes          String?
  createdById    String                     @db.Uuid
  submittedById  String?                    @db.Uuid
  reviewedById   String?                    @db.Uuid
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewComment  String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User                       @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy    User?                      @relation("BudgetSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy     User?                      @relation("BudgetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  categories     BudgetCategory[]
  fundingSources BudgetFundingSource[]
  periods        FinancialReportingPeriod[]
  entries        FinanceEntry[]
  documents      FinanceDocument[]
  approvals      BudgetApproval[]

  @@unique([projectId, fiscalYear])
  @@index([fiscalYear, status])
  @@index([createdById])
}

model BudgetCategory {
  id             String         @id @default(uuid()) @db.Uuid
  budgetId       String         @db.Uuid
  code           String
  name           String
  description    String?
  proposedAmount Decimal        @db.Decimal(18, 2)
  approvedAmount Decimal        @default(0) @db.Decimal(18, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  budget         ProjectBudget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entries        FinanceEntry[]

  @@unique([budgetId, code])
  @@index([budgetId])
}

model BudgetFundingSource {
  id        String        @id @default(uuid()) @db.Uuid
  budgetId  String        @db.Uuid
  name      String
  reference String?
  amount    Decimal       @db.Decimal(18, 2)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  budget    ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model FinancialReportingPeriod {
  id        String                @id @default(uuid()) @db.Uuid
  budgetId  String                @db.Uuid
  name      String
  startDate DateTime
  endDate   DateTime
  status    FinancialPeriodStatus @default(OPEN)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  budget    ProjectBudget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entries   FinanceEntry[]

  @@unique([budgetId, name])
  @@index([budgetId, startDate, endDate])
}

model FinanceEntry {
  id                 String                    @id @default(uuid()) @db.Uuid
  budgetId           String                    @db.Uuid
  categoryId         String                    @db.Uuid
  periodId           String?                   @db.Uuid
  type               FinanceEntryType
  description        String
  reference          String
  amount             Decimal                   @db.Decimal(18, 2)
  transactionDate    DateTime
  counterparty       String?
  status             FinanceRecordStatus       @default(DRAFT)
  sourceCommitmentId String?                   @db.Uuid
  createdById        String                    @db.Uuid
  reviewedById       String?                   @db.Uuid
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewComment      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  budget             ProjectBudget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category           BudgetCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  period             FinancialReportingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  sourceCommitment   FinanceEntry?             @relation("CommitmentRealizations", fields: [sourceCommitmentId], references: [id], onDelete: SetNull)
  realizations       FinanceEntry[]            @relation("CommitmentRealizations")
  createdBy          User                      @relation("FinanceEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy         User?                     @relation("FinanceEntryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents          FinanceDocument[]

  @@unique([budgetId, reference])
  @@index([budgetId, type, status])
  @@index([categoryId])
  @@index([periodId])
  @@index([sourceCommitmentId])
  @@index([createdById])
}

model FinanceDocument {
  id           String        @id @default(uuid()) @db.Uuid
  budgetId     String        @db.Uuid
  entryId      String?       @db.Uuid
  name         String
  url          String
  mimeType     String?
  uploadedById String        @db.Uuid
  createdAt    DateTime      @default(now())
  budget       ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entry        FinanceEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@index([entryId])
}

model BudgetApproval {
  id        String                @id @default(uuid()) @db.Uuid
  budgetId  String                @db.Uuid
  action    FinanceApprovalAction
  actorId   String                @db.Uuid
  comment   String?
  createdAt DateTime              @default(now())
  budget    ProjectBudget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  actor     User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([budgetId, createdAt])
  @@index([actorId])
}

model ComplianceRegulation {
  id            String                   @id @default(uuid()) @db.Uuid
  code          String                   @unique
  title         String
  type          RegulationType
  jurisdiction  String
  regulator     String
  description   String
  effectiveDate DateTime
  reviewDate    DateTime?
  status        ComplianceRegisterStatus @default(DRAFT)
  createdById   String                   @db.Uuid
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  createdBy     User                     @relation("RegulationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  obligations   ComplianceObligation[]
  permits       CompliancePermit[]
  inspections   ComplianceInspection[]

  @@index([type, status])
  @@index([reviewDate])
}

model ComplianceObligation {
  id                   String                     @id @default(uuid()) @db.Uuid
  regulationId         String                     @db.Uuid
  projectId            String?                    @db.Uuid
  reference            String
  title                String
  requirement          String
  department           String
  responsibleOfficerId String                     @db.Uuid
  dueDate              DateTime
  frequency            String?
  weight               Int                        @default(1)
  status               ComplianceObligationStatus @default(NOT_STARTED)
  completedAt          DateTime?
  verifiedById         String?                    @db.Uuid
  verifiedAt           DateTime?
  verificationComment  String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  regulation           ComplianceRegulation       @relation(fields: [regulationId], references: [id], onDelete: Restrict)
  project              Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsibleOfficer   User                       @relation("ObligationOfficer", fields: [responsibleOfficerId], references: [id], onDelete: Restrict)
  verifiedBy           User?                      @relation("ObligationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  evidence             ComplianceEvidence[]
  nonConformities      NonConformity[]

  @@unique([regulationId, reference])
  @@index([department, status])
  @@index([responsibleOfficerId, dueDate])
  @@index([projectId])
}

model CompliancePermit {
  id                   String                @id @default(uuid()) @db.Uuid
  regulationId         String?               @db.Uuid
  projectId            String?               @db.Uuid
  permitNumber         String                @unique
  title                String
  permitType           String
  issuingAuthority     String
  holder               String
  issueDate            DateTime
  expiryDate           DateTime
  status               PermitStatus          @default(DRAFT)
  renewalLeadDays      Int                   @default(90)
  conditions           String?
  responsibleOfficerId String                @db.Uuid
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  regulation           ComplianceRegulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsibleOfficer   User                  @relation("PermitOfficer", fields: [responsibleOfficerId], references: [id], onDelete: Restrict)
  evidence             ComplianceEvidence[]

  @@index([status, expiryDate])
  @@index([responsibleOfficerId])
  @@index([projectId])
}

model ComplianceInspection {
  id                   String                @id @default(uuid()) @db.Uuid
  regulationId         String?               @db.Uuid
  projectId            String?               @db.Uuid
  reference            String                @unique
  title                String
  inspector            String
  location             String
  scheduledDate        DateTime
  completedDate        DateTime?
  status               InspectionStatus      @default(SCHEDULED)
  outcome              InspectionOutcome     @default(NOT_ASSESSED)
  score                Int?
  notes                String?
  responsibleOfficerId String                @db.Uuid
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  regulation           ComplianceRegulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsibleOfficer   User                  @relation("InspectionOfficer", fields: [responsibleOfficerId], references: [id], onDelete: Restrict)
  nonConformities      NonConformity[]
  evidence             ComplianceEvidence[]

  @@index([status, scheduledDate])
  @@index([responsibleOfficerId])
  @@index([projectId])
}

model NonConformity {
  id                   String                @id @default(uuid()) @db.Uuid
  obligationId         String?               @db.Uuid
  inspectionId         String?               @db.Uuid
  projectId            String?               @db.Uuid
  reference            String                @unique
  title                String
  description          String
  severity             NonConformitySeverity @default(MEDIUM)
  status               NonConformityStatus   @default(OPEN)
  detectedAt           DateTime
  dueDate              DateTime
  responsibleOfficerId String                @db.Uuid
  rootCause            String?
  escalationLevel      EscalationLevel       @default(NONE)
  escalatedAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  obligation           ComplianceObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  inspection           ComplianceInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsibleOfficer   User                  @relation("NonConformityOfficer", fields: [responsibleOfficerId], references: [id], onDelete: Restrict)
  correctiveActions    CorrectiveAction[]
  evidence             ComplianceEvidence[]

  @@index([severity, status])
  @@index([responsibleOfficerId, dueDate])
  @@index([projectId])
}

model CorrectiveAction {
  id                   String                 @id @default(uuid()) @db.Uuid
  nonConformityId      String                 @db.Uuid
  title                String
  description          String
  responsibleOfficerId String                 @db.Uuid
  dueDate              DateTime
  status               CorrectiveActionStatus @default(PLANNED)
  progress             Int                    @default(0)
  completionNotes      String?
  verifiedById         String?                @db.Uuid
  verifiedAt           DateTime?
  verificationNotes    String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  nonConformity        NonConformity          @relation(fields: [nonConformityId], references: [id], onDelete: Cascade)
  responsibleOfficer   User                   @relation("CorrectiveActionOfficer", fields: [responsibleOfficerId], references: [id], onDelete: Restrict)
  verifiedBy           User?                  @relation("CorrectiveActionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  evidence             ComplianceEvidence[]

  @@index([nonConformityId, status])
  @@index([responsibleOfficerId, dueDate])
}

model ComplianceEvidence {
  id                 String                @id @default(uuid()) @db.Uuid
  obligationId       String?               @db.Uuid
  permitId           String?               @db.Uuid
  inspectionId       String?               @db.Uuid
  nonConformityId    String?               @db.Uuid
  correctiveActionId String?               @db.Uuid
  name               String
  url                String
  mimeType           String?
  notes              String?
  uploadedById       String                @db.Uuid
  createdAt          DateTime              @default(now())
  obligation         ComplianceObligation? @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  permit             CompliancePermit?     @relation(fields: [permitId], references: [id], onDelete: Cascade)
  inspection         ComplianceInspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  nonConformity      NonConformity?        @relation(fields: [nonConformityId], references: [id], onDelete: Cascade)
  correctiveAction   CorrectiveAction?     @relation(fields: [correctiveActionId], references: [id], onDelete: Cascade)
  uploadedBy         User                  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([obligationId])
  @@index([permitId])
  @@index([inspectionId])
  @@index([nonConformityId])
  @@index([correctiveActionId])
}

model ComplianceWorkflowEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  fromStatus String?
  toStatus   String?
  comment    String?
  actorId    String   @db.Uuid
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
}

model Supplier {
  id                     String                      @id @default(uuid()) @db.Uuid
  supplierCode           String                      @unique
  legalName              String
  tradingName            String?
  registrationNumber     String?                     @unique
  taxNumber              String?
  sector                 SupplierSector
  categories             String[]
  country                String
  address                String?
  contactName            String
  contactEmail           String
  contactPhone           String?
  status                 SupplierStatus              @default(DRAFT)
  localContentPercentage Decimal                     @default(0) @db.Decimal(5, 2)
  hseCertification       String?
  notes                  String?
  createdById            String                      @db.Uuid
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  createdBy              User                        @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: Restrict)
  qualifications         SupplierQualification[]
  contracts              SupplierContract[]
  purchaseRequests       PurchaseRequest[]
  deliveries             SupplierDelivery[]
  performanceReviews     SupplierPerformanceReview[]
  evidence               SupplierEvidence[]

  @@index([legalName])
  @@index([sector, status])
  @@index([createdById])
}

model SupplierQualification {
  id                String              @id @default(uuid()) @db.Uuid
  supplierId        String              @db.Uuid
  reference         String              @unique
  submittedAt       DateTime?
  reviewedAt        DateTime?
  expiresAt         DateTime?
  status            QualificationStatus @default(NOT_STARTED)
  technicalScore    Int?
  financialScore    Int?
  hseScore          Int?
  localContentScore Int?
  overallScore      Decimal?            @db.Decimal(5, 2)
  reviewerId        String?             @db.Uuid
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  reviewer          User?               @relation("QualificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  evidence          SupplierEvidence[]

  @@index([supplierId, status])
  @@index([expiresAt])
}

model SupplierContract {
  id                   String                      @id @default(uuid()) @db.Uuid
  supplierId           String                      @db.Uuid
  projectId            String?                     @db.Uuid
  contractNumber       String                      @unique
  title                String
  description          String?
  startDate            DateTime
  endDate              DateTime
  currency             String                      @default("USD")
  value                Decimal                     @db.Decimal(18, 2)
  status               SupplierContractStatus      @default(DRAFT)
  renewalLeadDays      Int                         @default(90)
  responsibleOfficerId String                      @db.Uuid
  signedAt             DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  supplier             Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  project              Project?                    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsibleOfficer   User                        @relation("SupplierContractOfficer", fields: [responsibleOfficerId], references: [id], onDelete: Restrict)
  purchaseRequests     PurchaseRequest[]
  deliveries           SupplierDelivery[]
  performanceReviews   SupplierPerformanceReview[]
  evidence             SupplierEvidence[]

  @@index([supplierId, status])
  @@index([projectId])
  @@index([endDate])
}

model PurchaseRequest {
  id              String                @id @default(uuid()) @db.Uuid
  requestNumber   String                @unique
  supplierId      String?               @db.Uuid
  contractId      String?               @db.Uuid
  projectId       String?               @db.Uuid
  title           String
  description     String
  requiredBy      DateTime
  currency        String                @default("USD")
  estimatedAmount Decimal               @db.Decimal(18, 2)
  status          PurchaseRequestStatus @default(DRAFT)
  createdById     String                @db.Uuid
  reviewedById    String?               @db.Uuid
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewComment   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  supplier        Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  contract        SupplierContract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  project         Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       User                  @relation("PurchaseRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy      User?                 @relation("PurchaseRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  deliveries      SupplierDelivery[]
  evidence        SupplierEvidence[]

  @@index([supplierId, status])
  @@index([projectId])
  @@index([createdById])
  @@index([requiredBy])
}

model SupplierDelivery {
  id                String             @id @default(uuid()) @db.Uuid
  supplierId        String             @db.Uuid
  contractId        String?            @db.Uuid
  purchaseRequestId String?            @db.Uuid
  deliveryNumber    String             @unique
  scheduledDate     DateTime
  actualDate        DateTime?
  location          String
  items             String
  status            DeliveryStatus     @default(SCHEDULED)
  qualityScore      Int?
  hseScore          Int?
  acceptedById      String?            @db.Uuid
  acceptanceNotes   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  supplier          Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  contract          SupplierContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  purchaseRequest   PurchaseRequest?   @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  acceptedBy        User?              @relation("DeliveryAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  evidence          SupplierEvidence[]

  @@index([supplierId, status])
  @@index([contractId])
  @@index([purchaseRequestId])
  @@index([scheduledDate])
}

model SupplierPerformanceReview {
  id                String             @id @default(uuid()) @db.Uuid
  supplierId        String             @db.Uuid
  contractId        String?            @db.Uuid
  periodStart       DateTime
  periodEnd         DateTime
  qualityScore      Int
  deliveryScore     Int
  hseScore          Int
  localContentScore Int
  costScore         Int
  overallScore      Decimal            @db.Decimal(5, 2)
  comments          String?
  reviewerId        String             @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  supplier          Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  contract          SupplierContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  reviewer          User               @relation("SupplierReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  evidence          SupplierEvidence[]

  @@index([supplierId, periodEnd])
  @@index([contractId])
}

model SupplierEvidence {
  id                String                     @id @default(uuid()) @db.Uuid
  supplierId        String?                    @db.Uuid
  qualificationId   String?                    @db.Uuid
  contractId        String?                    @db.Uuid
  purchaseRequestId String?                    @db.Uuid
  deliveryId        String?                    @db.Uuid
  reviewId          String?                    @db.Uuid
  name              String
  url               String
  mimeType          String?
  notes             String?
  uploadedById      String                     @db.Uuid
  createdAt         DateTime                   @default(now())
  supplier          Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  qualification     SupplierQualification?     @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  contract          SupplierContract?          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  purchaseRequest   PurchaseRequest?           @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  delivery          SupplierDelivery?          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  review            SupplierPerformanceReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  uploadedBy        User                       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([qualificationId])
  @@index([contractId])
  @@index([purchaseRequestId])
  @@index([deliveryId])
  @@index([reviewId])
}

model SupplierWorkflowEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  fromStatus String?
  toStatus   String?
  comment    String?
  actorId    String   @db.Uuid
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
}

model ResultsFramework {
  id           String                 @id @default(uuid()) @db.Uuid
  projectId    String                 @db.Uuid
  code         String                 @unique
  name         String
  description  String?
  startDate    DateTime
  endDate      DateTime
  status       ResultsFrameworkStatus @default(DRAFT)
  ownerId      String                 @db.Uuid
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User                   @relation("ResultsFrameworkOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  resultLevels ResultLevel[]
  indicators   KpiIndicator[]
  periods      KpiReportingPeriod[]

  @@index([projectId, status])
  @@index([ownerId])
  @@index([startDate, endDate])
}

model ResultLevel {
  id          String           @id @default(uuid()) @db.Uuid
  frameworkId String           @db.Uuid
  parentId    String?          @db.Uuid
  code        String
  type        ResultLevelType
  title       String
  description String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  framework   ResultsFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  parent      ResultLevel?     @relation("ResultLevelHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ResultLevel[]    @relation("ResultLevelHierarchy")
  indicators  KpiIndicator[]

  @@unique([frameworkId, code])
  @@index([frameworkId, type, sortOrder])
  @@index([parentId])
}

model KpiIndicator {
  id                String             @id @default(uuid()) @db.Uuid
  frameworkId       String             @db.Uuid
  resultLevelId     String?            @db.Uuid
  code              String             @unique
  name              String
  description       String
  unit              String
  dataType          KpiDataType        @default(NUMBER)
  direction         KpiDirection       @default(INCREASE)
  frequency         KpiFrequency       @default(QUARTERLY)
  baselineValue     Decimal            @db.Decimal(20, 4)
  baselineDate      DateTime
  finalTargetValue  Decimal            @db.Decimal(20, 4)
  weight            Int                @default(1)
  tolerance         Decimal            @default(0) @db.Decimal(20, 4)
  disaggregation    Json?
  formula           String?
  sourceDescription String?
  status            KpiIndicatorStatus @default(DRAFT)
  ownerId           String             @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  framework         ResultsFramework   @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  resultLevel       ResultLevel?       @relation(fields: [resultLevelId], references: [id], onDelete: SetNull)
  owner             User               @relation("KpiIndicatorOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  targets           KpiTarget[]
  measurements      KpiMeasurement[]
  dataSources       KpiDataSource[]
  evidence          KpiEvidence[]

  @@index([frameworkId, status])
  @@index([resultLevelId])
  @@index([ownerId])
}

model KpiReportingPeriod {
  id            String           @id @default(uuid()) @db.Uuid
  frameworkId   String           @db.Uuid
  name          String
  startDate     DateTime
  endDate       DateTime
  dueDate       DateTime
  status        KpiPeriodStatus  @default(OPEN)
  createdById   String           @db.Uuid
  submittedById String?          @db.Uuid
  reviewedById  String?          @db.Uuid
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  framework     ResultsFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  createdBy     User             @relation("KpiPeriodCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy   User?            @relation("KpiPeriodSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy    User?            @relation("KpiPeriodReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  targets       KpiTarget[]
  measurements  KpiMeasurement[]

  @@unique([frameworkId, name])
  @@index([frameworkId, status])
  @@index([startDate, endDate])
}

model KpiTarget {
  id          String             @id @default(uuid()) @db.Uuid
  indicatorId String             @db.Uuid
  periodId    String             @db.Uuid
  targetValue Decimal            @db.Decimal(20, 4)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  indicator   KpiIndicator       @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  period      KpiReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, periodId])
  @@index([periodId])
}

model KpiMeasurement {
  id                  String               @id @default(uuid()) @db.Uuid
  indicatorId         String               @db.Uuid
  periodId            String               @db.Uuid
  actualValue         Decimal              @db.Decimal(20, 4)
  measuredAt          DateTime
  narrative           String?
  disaggregation      Json?
  sourceType          KpiSourceType        @default(MANUAL)
  sourceReference     String?
  status              KpiMeasurementStatus @default(DRAFT)
  createdById         String               @db.Uuid
  verifiedById        String?              @db.Uuid
  submittedAt         DateTime?
  verifiedAt          DateTime?
  verificationComment String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  indicator           KpiIndicator         @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  period              KpiReportingPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  createdBy           User                 @relation("KpiMeasurementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy          User?                @relation("KpiMeasurementVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  evidence            KpiEvidence[]

  @@index([indicatorId, periodId, status])
  @@index([createdById])
  @@index([measuredAt])
}

model KpiDataSource {
  id            String         @id @default(uuid()) @db.Uuid
  indicatorId   String         @db.Uuid
  name          String
  sourceType    KpiSourceType
  endpoint      String?
  valuePath     String?
  aggregation   KpiAggregation @default(VALUE)
  configuration Json?
  isActive      Boolean        @default(true)
  lastSyncedAt  DateTime?
  lastValue     Decimal?       @db.Decimal(20, 4)
  lastError     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  indicator     KpiIndicator   @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([indicatorId, isActive])
  @@index([sourceType])
}

model KpiEvidence {
  id            String          @id @default(uuid()) @db.Uuid
  indicatorId   String?         @db.Uuid
  measurementId String?         @db.Uuid
  name          String
  url           String
  mimeType      String?
  notes         String?
  uploadedById  String          @db.Uuid
  createdAt     DateTime        @default(now())
  indicator     KpiIndicator?   @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  measurement   KpiMeasurement? @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  uploadedBy    User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([indicatorId])
  @@index([measurementId])
}

model KpiWorkflowEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  fromStatus String?
  toStatus   String?
  comment    String?
  actorId    String   @db.Uuid
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
}

model ProjectObjective {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  description String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectActivity {
  id           String         @id @default(uuid()) @db.Uuid
  projectId    String         @db.Uuid
  title        String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  status       WorkItemStatus @default(NOT_STARTED)
  progress     Int            @default(0)
  assignedToId String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("ActivityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assignedToId])
}

model ProjectMilestone {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  title       String
  description String?
  dueDate     DateTime
  status      WorkItemStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, dueDate])
}

model ProjectDeliverable {
  id           String         @id @default(uuid()) @db.Uuid
  projectId    String         @db.Uuid
  title        String
  description  String?
  dueDate      DateTime
  status       WorkItemStatus @default(NOT_STARTED)
  assignedToId String?        @db.Uuid
  acceptedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("DeliverableAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([projectId, dueDate])
  @@index([assignedToId])
}

model ProjectRisk {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @db.Uuid
  title       String
  description String
  level       RiskLevel  @default(MEDIUM)
  status      RiskStatus @default(OPEN)
  mitigation  String?
  ownerId     String?    @db.Uuid
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?      @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([ownerId])
}

model ProjectAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  role      String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
}
