generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  PROJECT_MANAGER
  COMPLIANCE_OFFICER
  ME_OFFICER
  FINANCE_OFFICER
  SUPPLY_CHAIN_OFFICER
  DEPARTMENT_HEAD
  VIEWER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATING
  ACCEPTED
  CLOSED
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CLOSED
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

enum FinanceEntryType {
  COMMITMENT
  EXPENDITURE
}

enum FinanceRecordStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum FinanceApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  CLOSED
  REOPENED
}

enum RegulationType {
  LAW
  REGULATION
  POLICY
  STANDARD
  GUIDELINE
  LICENCE_REQUIREMENT
}

enum ComplianceRegisterStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ComplianceObligationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  OVERDUE
  WAIVED
}

enum PermitStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
  REVOKED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionOutcome {
  NOT_ASSESSED
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
}

enum NonConformitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NonConformityStatus {
  OPEN
  INVESTIGATING
  ACTION_IN_PROGRESS
  PENDING_VERIFICATION
  CLOSED
  ESCALATED
}

enum CorrectiveActionStatus {
  PLANNED
  IN_PROGRESS
  PENDING_VERIFICATION
  COMPLETED
  OVERDUE
  CANCELLED
}

enum EscalationLevel {
  NONE
  DEPARTMENT_HEAD
  EXECUTIVE
  REGULATOR
}

model User {
  id                           String                    @id @default(uuid()) @db.Uuid
  name                         String
  email                        String                    @unique
  passwordHash                 String
  role                         Role                      @default(VIEWER)
  walletAddress                String?
  isActive                     Boolean                   @default(true)
  tokenVersion                 Int                       @default(0)
  lastLoginAt                  DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  auditEvents                  AuditLog[]                @relation("AuditActor")
  managedProjects              Project[]                 @relation("ProjectManager")
  projectAssignments           ProjectAssignment[]
  assignedActivities           ProjectActivity[]         @relation("ActivityAssignee")
  assignedDeliverables         ProjectDeliverable[]      @relation("DeliverableAssignee")
  ownedRisks                   ProjectRisk[]             @relation("RiskOwner")
  createdBudgets               ProjectBudget[]           @relation("BudgetCreator")
  submittedBudgets             ProjectBudget[]           @relation("BudgetSubmitter")
  reviewedBudgets              ProjectBudget[]           @relation("BudgetReviewer")
  budgetApprovals              BudgetApproval[]
  createdFinanceEntries        FinanceEntry[]            @relation("FinanceEntryCreator")
  reviewedFinanceEntries       FinanceEntry[]            @relation("FinanceEntryReviewer")
  financeDocuments             FinanceDocument[]
  createdRegulations           ComplianceRegulation[]    @relation("RegulationCreator")
  responsibleObligations       ComplianceObligation[]    @relation("ObligationOfficer")
  verifiedObligations          ComplianceObligation[]    @relation("ObligationVerifier")
  responsiblePermits           CompliancePermit[]        @relation("PermitOfficer")
  responsibleInspections       ComplianceInspection[]    @relation("InspectionOfficer")
  responsibleNonConformities   NonConformity[]           @relation("NonConformityOfficer")
  responsibleCorrectiveActions CorrectiveAction[]        @relation("CorrectiveActionOfficer")
  verifiedCorrectiveActions    CorrectiveAction[]        @relation("CorrectiveActionVerifier")
  complianceEvidence           ComplianceEvidence[]
  complianceEvents             ComplianceWorkflowEvent[]

  @@index([role])
  @@index([isActive])
}

model Project {
  id                    String                 @id @default(uuid()) @db.Uuid
  title                 String
  code                  String                 @unique
  department            String
  location              String
  managerId             String                 @db.Uuid
  startDate             DateTime
  endDate               DateTime
  status                ProjectStatus          @default(PLANNED)
  progress              Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  manager               User                   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  objectives            ProjectObjective[]
  activities            ProjectActivity[]
  milestones            ProjectMilestone[]
  deliverables          ProjectDeliverable[]
  risks                 ProjectRisk[]
  assignments           ProjectAssignment[]
  budgets               ProjectBudget[]
  complianceObligations ComplianceObligation[]
  compliancePermits     CompliancePermit[]
  complianceInspections ComplianceInspection[]
  nonConformities       NonConformity[]

  @@index([department])
  @@index([managerId])
  @@index([status])
  @@index([startDate, endDate])
}

model ProjectBudget {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @db.Uuid
  fiscalYear        Int
  title             String
  currency          String          @default("USD")
  proposedAmount    Decimal         @db.Decimal(18, 2)
  approvedAmount    Decimal         @default(0) @db.Decimal(18, 2)
  status            BudgetStatus    @default(DRAFT)
  notes             String?
  createdById       String          @db.Uuid
  submittedById     String?         @db.Uuid
  reviewedById      String?         @db.Uuid
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewComment     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User            @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy       User?           @relation("BudgetSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy        User?           @relation("BudgetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  categories        BudgetCategory[]
  fundingSources    BudgetFundingSource[]
  periods           FinancialReportingPeriod[]
  entries           FinanceEntry[]
  documents         FinanceDocument[]
  approvals         BudgetApproval[]

  @@unique([projectId, fiscalYear])
  @@index([fiscalYear, status])
  @@index([createdById])
}

model BudgetCategory {
  id              String          @id @default(uuid()) @db.Uuid
  budgetId        String          @db.Uuid
  code            String
  name            String
  description     String?
  proposedAmount  Decimal         @db.Decimal(18, 2)
  approvedAmount  Decimal         @default(0) @db.Decimal(18, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  budget          ProjectBudget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entries         FinanceEntry[]

  @@unique([budgetId, code])
  @@index([budgetId])
}

model BudgetFundingSource {
  id          String        @id @default(uuid()) @db.Uuid
  budgetId    String        @db.Uuid
  name        String
  reference   String?
  amount      Decimal       @db.Decimal(18, 2)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  budget      ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model FinancialReportingPeriod {
  id          String                  @id @default(uuid()) @db.Uuid
  budgetId    String                  @db.Uuid
  name        String
  startDate   DateTime
  endDate     DateTime
  status      FinancialPeriodStatus   @default(OPEN)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  budget      ProjectBudget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entries     FinanceEntry[]

  @@unique([budgetId, name])
  @@index([budgetId, startDate, endDate])
}

model FinanceEntry {
  id                   String               @id @default(uuid()) @db.Uuid
  budgetId             String               @db.Uuid
  categoryId           String               @db.Uuid
  periodId             String?              @db.Uuid
  type                 FinanceEntryType
  description          String
  reference            String
  amount               Decimal              @db.Decimal(18, 2)
  transactionDate      DateTime
  counterparty         String?
  status               FinanceRecordStatus  @default(DRAFT)
  sourceCommitmentId   String?              @db.Uuid
  createdById          String               @db.Uuid
  reviewedById         String?              @db.Uuid
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewComment        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  budget               ProjectBudget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category             BudgetCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  period               FinancialReportingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  sourceCommitment     FinanceEntry?         @relation("CommitmentRealizations", fields: [sourceCommitmentId], references: [id], onDelete: SetNull)
  realizations         FinanceEntry[]        @relation("CommitmentRealizations")
  createdBy            User                 @relation("FinanceEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy           User?                @relation("FinanceEntryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents            FinanceDocument[]

  @@unique([budgetId, reference])
  @@index([budgetId, type, status])
  @@index([categoryId])
  @@index([periodId])
  @@index([sourceCommitmentId])
  @@index([createdById])
}

model FinanceDocument {
  id           String         @id @default(uuid()) @db.Uuid
  budgetId     String         @db.Uuid
  entryId      String?        @db.Uuid
  name         String
  url          String
  mimeType     String?
  uploadedById String         @db.Uuid
  createdAt    DateTime       @default(now())
  budget       ProjectBudget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entry        FinanceEntry?  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@index([entryId])
}

model BudgetApproval {
  id        String                @id @default(uuid()) @db.Uuid
  budgetId  String                @db.Uuid
  action    FinanceApprovalAction
  actorId   String                @db.Uuid
  comment   String?
  createdAt DateTime              @default(now())
  budget    ProjectBudget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  actor     User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([budgetId, createdAt])
  @@index([actorId])
}

model ProjectObjective {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  description String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectActivity {
  id           String         @id @default(uuid()) @db.Uuid
  projectId    String         @db.Uuid
  title        String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  status       WorkItemStatus @default(NOT_STARTED)
  progress     Int            @default(0)
  assignedToId String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("ActivityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assignedToId])
}

model ProjectMilestone {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  title       String
  description String?
  dueDate     DateTime
  status      WorkItemStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, dueDate])
}

model ProjectDeliverable {
  id           String         @id @default(uuid()) @db.Uuid
  projectId    String         @db.Uuid
  title        String
  description  String?
  dueDate      DateTime
  status       WorkItemStatus @default(NOT_STARTED)
  assignedToId String?        @db.Uuid
  acceptedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("DeliverableAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([projectId, dueDate])
  @@index([assignedToId])
}

model ProjectRisk {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @db.Uuid
  title       String
  description String
  level       RiskLevel  @default(MEDIUM)
  status      RiskStatus @default(OPEN)
  mitigation  String?
  ownerId     String?    @db.Uuid
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?      @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([ownerId])
}

model ProjectAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  role      String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
}
