{
  "name": "smart-oil-field",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "src/frontend"
  ],
  "scripts": {
    "dev:web": "npm run start --workspace=smart-oil-field-dashboard",
    "dev:api": "npm run dev --workspace=@smart-oil-field/api",
    "build": "npm run db:generate && npm run build --workspace=@smart-oil-field/shared && npm run build --workspace=@smart-oil-field/database && npm run build --workspace=@smart-oil-field/api && npm run build --workspace=smart-oil-field-dashboard",
    "db:generate": "npm run generate --workspace=@smart-oil-field/database",
    "db:migrate": "npm run migrate:dev --workspace=@smart-oil-field/database",
    "db:seed": "npm run seed --workspace=@smart-oil-field/database",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}
